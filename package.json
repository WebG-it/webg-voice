{
  "name": "webg-voice",
  "private": true,
  "description": "Estensione Chrome di WebG: lettura ad alta voce in italiano con Kokoro (voci Sara e Nicola) e dettatura con Whisper, locali e offline",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "node scripts/build.mjs",
    "release": "node scripts/release.mjs",
    "store": "node scripts/scheda-store.mjs",
    "test:fonemi": "node test/confronta-fonemi.mjs",
    "test:testo": "node test/prova-testo.mjs",
    "build:test": "node scripts/build.mjs --test",
    "test:pronuncia": "node test/pronuncia.mjs",
    "test:funzioni": "node test/funzioni.mjs",
    "test:pulizia": "node test/pulizia.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "1.30.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WebG-it/webg-voice.git"
  }
}
