{
  "manifest_version": 3,
  "name": "__MSG_nomeEstensione__",
  "short_name": "__MSG_nomeEstensione__",
  "default_locale": "it",
  "version": "1.1.0",
  "description": "__MSG_descrizione__",
  "homepage_url": "https://github.com/WebG-it/webg-voice",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "contextMenus", "offscreen", "storage", "unlimitedStorage"],
  "host_permissions": [
    "https://github.com/WebG-it/webg-voice/*",
    "https://release-assets.githubusercontent.com/*",
    "https://huggingface.co/onnx-community/*",
    "https://*.hf.co/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_titoloAzione__",
    "default_icon": { "16": "icone/icona-16.png", "32": "icone/icona-32.png", "48": "icone/icona-48.png" }
  },
  "icons": { "16": "icone/icona-16.png", "32": "icone/icona-32.png", "48": "icone/icona-48.png", "128": "icone/icona-128.png" },
  "options_ui": { "page": "diagnostica.html", "open_in_tab": true },
  "commands": {
    "leggi-selezione": {
      "suggested_key": { "default": "Alt+Q", "mac": "MacCtrl+Q" },
      "description": "__MSG_comandoLeggi__"
    },
    "ferma-lettura": {
      "suggested_key": { "default": "Alt+W", "mac": "MacCtrl+W" },
      "description": "__MSG_comandoFerma__"
    }
  },
  "cross_origin_embedder_policy": { "value": "require-corp" },
  "cross_origin_opener_policy": { "value": "same-origin" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
